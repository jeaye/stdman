.TH std::ranges::range_size_t,std::ranges::range_difference_t,std::ranges::range_value_t 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::ranges::range_size_t,std::ranges::range_difference_t,std::ranges::range_value_t \- std::ranges::range_size_t,std::ranges::range_difference_t,std::ranges::range_value_t

.SH Synopsis
Defined in header <ranges>
template< ranges::sized_range R >                                        \fB(1)\fP \fI(since C++20)\fP
using range_size_t = decltype(ranges::size(std::declval<R&>()));
template< ranges::range R >
using range_difference_t =                                               \fB(2)\fP \fI(since C++20)\fP
std::iter_difference_t<ranges::iterator_t<R>>;
template< ranges::range R >                                              \fB(3)\fP \fI(since C++20)\fP
using range_value_t = std::iter_value_t<ranges::iterator_t<R>>;

1) Used to obtain the size type of the sized_range type R.
2) Used to obtain the difference type of the iterator type of range type R.
3) Used to obtain the value type of the iterator type of range type R.

.SH Template parameters

R - a range type or a sized_range type

