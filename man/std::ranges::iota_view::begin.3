.TH std::ranges::iota_view::begin 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::ranges::iota_view::begin \- std::ranges::iota_view::begin

.SH Synopsis
constexpr /*iterator*/ begin() const;  \fI(since C++20)\fP

Obtains an iterator to the beginning value.

.SH Return value

iterator ﻿{value_ ﻿}

.SH Example


// Run this code

#include <iostream>
#include <ranges>

int main()
{
    auto iota{std::views::iota(2, 6)};
    auto iter{iota.begin()};
    while (iter != iota.end())
        std::cout << *iter++ << ' ';
    std::cout << '\\n';
}

.SH Output:

2 3 4 5
