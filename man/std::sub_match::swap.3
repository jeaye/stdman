.TH std::sub_match::swap 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::sub_match::swap \- std::sub_match::swap

.SH Synopsis
void swap( sub_match& s ) noexcept(/* see below */);  \fI(since C++11)\fP

Exchanges the contents of two sub-match objects. Equivalent to

this->pair<BidirIt, BidirIt>::swap(s);
std::swap(matched, s.matched);

.SH Parameters

s          -          a sub_match to swap with
.SH Type requirements
-
BidirIt must meet the requirements of LegacySwappable.

.SH Exceptions

noexcept specification:
noexcept(std::is_nothrow_swappable_v<BidirIt>)

.SH Example


// Run this code

#include <cassert>
#include <iostream>
#include <regex>

int main()
{
    const char* s = "Quick red cat";
    std::sub_match<const char*> x, y;

    x.first = &s[0];
    x.second = &s[5];
    x.matched = false;

    y.first = &s[012];
    y.second = &s[13];
    y.matched = true;

    std::cout << "Before swap:\\n";
    std::cout << "x.str() = [" << x.str() << "]\\n";
    std::cout << "y.str() = [" << y.str() << "]\\n";
    assert(!x.matched and y.matched);

    x.swap(y);

    std::cout << "After swap:\\n";
    std::cout << "x.str() = [" << x.str() << "]\\n";
    std::cout << "y.str() = [" << y.str() << "]\\n";
    assert(x.matched and !y.matched);
}

.SH Output:

Before swap:
x.str() = []
y.str() = [cat]
After swap:
x.str() = [cat]
y.str() = []

