.TH std::get(std::tuple) 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::get(std::tuple) \- std::get(std::tuple)

.SH Synopsis
Defined in header <tuple>
template< std::size_t I, class... Types >
                                                                   \fI(since C++11)\fP
typename std::tuple_element<I, std::tuple<Types...>>::type&    \fB(1)\fP (constexpr since C++14)

get( std::tuple<Types...>& t ) noexcept;
template< std::size_t I, class... Types >
                                                                   \fI(since C++11)\fP
typename std::tuple_element<I, std::tuple<Types...>>::type&&   \fB(2)\fP (constexpr since C++14)

get( std::tuple<Types...>&& t ) noexcept;
template< std::size_t I, class... Types >

const typename std::tuple_element<I,                           \fB(3)\fP \fI(since C++11)\fP
std::tuple<Types...>>::type&                                       (constexpr since C++14)

get( const std::tuple<Types...>& t ) noexcept;
template< std::size_t I, class... Types >

const typename std::tuple_element<I,                           \fB(4)\fP \fI(since C++11)\fP
std::tuple<Types...>>::type&&                                      (constexpr since C++14)

get( const std::tuple<Types...>&& t ) noexcept;
template< class T, class... Types >                            \fB(5)\fP \fI(since C++14)\fP
constexpr T& get( std::tuple<Types...>& t ) noexcept;
template< class T, class... Types >                            \fB(6)\fP \fI(since C++14)\fP
constexpr T&& get( std::tuple<Types...>&& t ) noexcept;
template< class T, class... Types >
constexpr const T& get( const std::tuple<Types...>& t )        \fB(7)\fP \fI(since C++14)\fP
noexcept;
template< class T, class... Types >
constexpr const T&& get( const std::tuple<Types...>&& t )      \fB(8)\fP \fI(since C++14)\fP
noexcept;

1-4) Extracts the I^th element from the tuple. I must be an integer value in [0,
sizeof...(Types)).
5-8) Extracts the element of the tuple t whose type is T. Fails to compile unless the
tuple has exactly one element of that type.

.SH Parameters

t - tuple whose contents to extract

.SH Return value

A reference to the selected element of t.

.SH Notes

   Feature-test macro     Value    Std               Feature
__cpp_lib_tuples_by_type 201304L \fI(C++14)\fP Addressing tuples by type (5-8)

.SH Example


// Run this code

#include <cassert>
#include <iostream>
#include <string>
#include <tuple>

int main()
{
    auto x = std::make_tuple(1, "Foo", 3.14);

    // Index-based access
    std::cout << "( " << std::get<0>(x)
              << ", " << std::get<1>(x)
              << ", " << std::get<2>(x)
              << " )\\n";

    // Type-based access \fI(since C++14)\fP
    std::cout << "( " << std::get<int>(x)
              << ", " << std::get<const char*>(x)
              << ", " << std::get<double>(x)
              << " )\\n";

    const std::tuple<int, const int, double, double> y(1, 2, 6.9, 9.6);
    const int& i1 = std::get<int>(y); // OK: not ambiguous
    assert(i1 == 1);
    const int& i2 = std::get<const int>(y); // OK: not ambiguous
    assert(i2 == 2);
    // const double& d = std::get<double>(y); // Error: ill-formed (ambiguous)

    // Note: std::tie and structured binding can be
    // used to unpack a tuple into individual objects.
}

.SH Output:

( 1, Foo, 3.14 )
( 1, Foo, 3.14 )

