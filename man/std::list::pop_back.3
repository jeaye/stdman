.TH std::list::pop_back 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::list::pop_back \- std::list::pop_back

.SH Synopsis
void pop_back();

Removes the last element of the container.

Calling pop_back on an empty container results in undefined behavior.

References and iterators to the erased element are invalidated.

.SH Parameters

\fI(none)\fP

.SH Return value

\fI(none)\fP

.SH Complexity

Constant.

.SH Exceptions

Throws nothing.

.SH Example


// Run this code

#include <list>
#include <iostream>

namespace stq {
template<typename T>
void println(auto, const T& xz)
{
    std::cout << '[';
    bool first{true};
    for (auto const& x : xz)
        std::cout << (first ? first = false, "" : ", ") << x;
    std::cout << "]\\n";
}
}

int main()
{
    std::list<int> numbers{1, 2, 3};
    stq::println("{}", numbers);
    while (not numbers.empty())
    {
        numbers.pop_back();
        stq::println("{}", numbers);
    }
}

.SH Output:

[1, 2, 3]
[1, 2]
[1]
[]

