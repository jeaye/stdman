.TH std::chrono::system_clock::now 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::chrono::system_clock::now \- std::chrono::system_clock::now

.SH Synopsis
static std::chrono::time_point<std::chrono::system_clock> now() noexcept;  \fI(since C++11)\fP

Returns a time point representing the current point in time.

.SH Return value

A time point representing the current time.

.SH Example


// Run this code

#include <chrono>
#include <iostream>

int main()
{
    const auto now = std::chrono::system_clock::now();
    const std::time_t t_c = std::chrono::system_clock::to_time_t(now);
    std::cout << "The system clock is currently at " << std::ctime(&t_c);
}

.SH Possible output:

The system clock is currently at Thu Mar 30 13:28:27 2023
