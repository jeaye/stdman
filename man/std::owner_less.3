std::owner_less::operator()

member only of specialization \fB(2)\fP
bool operator()( const std::shared_ptr<T>& lhs,  \fI(since C++11)\fP
const std::shared_ptr<T>& rhs ) const noexcept;
member only of specialization \fB(3)\fP
