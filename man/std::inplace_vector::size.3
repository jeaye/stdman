.TH std::inplace_vector::size 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::inplace_vector::size \- std::inplace_vector::size

.SH Synopsis
constexpr size_type size() const;  (since C++26)

Returns the number of elements in the container, i.e. std::distance(begin(), end()).

.SH Parameters

\fI(none)\fP

.SH Return value

The number of elements in the container.

.SH Complexity

Constant.

.SH Example


// Run this code

#include <cassert>
#include <inplace_vector>

int main()
{
    std::inplace_vector<int, 4> nums;
    assert(nums.size() == 0);
    nums = {1, 2, 3, 4};
    assert(nums.size() == 4);
}

