.TH std::any::swap 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::any::swap \- std::any::swap

.SH Synopsis
void swap( any& other ) noexcept;  \fI(since C++17)\fP

Swaps the content of two any objects.

.SH Parameters

other - object to swap with

.SH Example


// Run this code

#include <any>
#include <print>
#include <string>
#include <string_view>

int main()
{
    std::any a = std::string{"King"};
    std::any b = std::string_view{"Queen"};
    std::println("a = {}", std::any_cast<std::string&>(a));
    std::println("b = {}", std::any_cast<std::string_view&>(b));
    std::println("swap(a, b)");
    a.swap(b);
    std::println("a = {}", std::any_cast<std::string_view&>(a));
    std::println("b = {}", std::any_cast<std::string&>(b));
}

.SH Output:

a = King
b = Queen
swap(a, b)
a = Queen
b = King
