.TH std::ranges::iota_view::empty 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::ranges::iota_view::empty \- std::ranges::iota_view::empty

.SH Synopsis
constexpr bool empty() const;  \fI(since C++20)\fP

Checks whether the range is empty (i.e. whether the beginning value is the same as the
sentinel value).

.SH Return value

value_  ==  bound_

.SH Example


// Run this code

#include <cassert>
#include <ranges>

int main()
{
    auto a = std::ranges::iota_view<int, int>();
    assert(a.empty());

    auto b = std::ranges::iota_view(4);
    assert(!b.empty());

    auto c = std::ranges::iota_view(4, 8);
    assert(!c.empty());
}

