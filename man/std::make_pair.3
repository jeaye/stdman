.TH std::make_pair 3 "2026.11.10" "http://cppreference.com" "C++ Standard Libary"
.SH NAME
std::make_pair \- std::make_pair

.SH Synopsis
Defined in header <utility>
template< class T1, class T2 >                          \fI(until C++11)\fP
std::pair<T1, T2> make_pair( T1 x, T2 y );
template< class T1, class T2 >                          \fI(since C++11)\fP
std::pair</*V1*/, /*V2*/> make_pair( T1&& x, T2&& y );  (constexpr since C++14)
                                                        \fI(until C++20)\fP
template< class T1, class T2 >

constexpr std::pair<std::unwrap_ref_decay_t<T1>,        \fI(since C++20)\fP
std::unwrap_ref_decay_t<T2>>

make_pair( T1&& x, T2&& y );

Creates a std::pair object, deducing the target type from the types of arguments.

Given types std::decay<T1>::type as U1 and std::decay<T2>::type as U2, the
types /*V1*/ and /*V2*/ are defined as follows:
                                                                             \fI(since C++11)\fP
  * If U1 is std::reference_wrapper<X>, /*V1*/ is X&; otherwise /*V1*/ is    \fI(until C++20)\fP
    U1.
  * If U2 is std::reference_wrapper<Y>, /*V2*/ is Y&; otherwise /*V2*/ is
    U2.

.SH Parameters

x, y - the values to construct the pair from

.SH Return value

std::pair<T1, T2>(x, y)                                             \fI(until C++11)\fP
std::pair</*V1*/, /*V2*/>(std::forward<T1>(x), std::forward<T2>(y)) \fI(since C++11)\fP
                                                                    \fI(until C++20)\fP
std::pair<std::unwrap_ref_decay_t<T1>, std::unwrap_ref_decay_t<T2>> \fI(since C++20)\fP
(std::forward<T1>(x), std::forward<T2>(y))

.SH Example


// Run this code

#include <functional>
#include <iostream>
#include <utility>

int main()
{
    int n = 1;
    int a[5] = {1, 2, 3, 4, 5};

    // build a pair from two ints
    auto p1 = std::make_pair(n, a[1]);
    std::cout << "The value of p1 is "
              << '(' << p1.first << ", " << p1.second << ")\\n";

    // build a pair from a reference to int and an array (decayed to pointer)
    auto p2 = std::make_pair(std::ref(n), a);
    n = 7;
    std::cout << "The value of p2 is "
              << '(' << p2.first << ", " << *(p2.second + 2) << ")\\n";
}

.SH Output:

The value of p1 is (1, 2)
The value of p2 is (7, 3)

